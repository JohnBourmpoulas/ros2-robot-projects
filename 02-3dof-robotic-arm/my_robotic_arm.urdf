<?xml version="1.0"?>
<robot name="my_robotic_arm">

    <!-- ========================================== -->
    <!-- MATERIALS                                  -->
    <!-- ========================================== -->

    <material name="blue">
        <color rgba="0.1 0.3 0.9 1"/>
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <material name="orange">
        <color rgba="1 0.5 0 1"/>
    </material>


    <!-- ========================================== -->
    <!-- LINKS                                      -->
    <!-- ========================================== -->

    <!-- Fixed reference frame at ground level -->
    <link name="base_footprint"/>


    <!-- Fixed base resting on the ground -->
    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="0.15" length="0.10"/>
            </geometry>

            <!-- The bottom of the base is located at Z = 0 -->
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
    </link>


    <!-- Rotating base -->
    <link name="rotating_base_link">
        <visual>
            <geometry>
                <cylinder radius="0.10" length="0.10"/>
            </geometry>

            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
    </link>


    <!-- Upper arm: 30 cm long -->
    <link name="upper_arm_link">
        <visual>
            <geometry>
                <box size="0.08 0.08 0.30"/>
            </geometry>

            <!-- The geometry extends upward from the joint -->
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <material name="orange"/>
        </visual>
    </link>


    <!-- Forearm: 25 cm long -->
    <link name="forearm_link">
        <visual>
            <geometry>
                <box size="0.07 0.07 0.25"/>
            </geometry>

            <origin xyz="0 0 0.125" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
    </link>


    <!-- Small end-effector placeholder at the tip of the arm -->
    <link name="tool_link">
        <visual>
            <geometry>
                <sphere radius="0.045"/>
            </geometry>

            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="grey"/>
        </visual>
    </link>


    <!-- ========================================== -->
    <!-- JOINTS                                     -->
    <!-- ========================================== -->

    <!-- Fixed connection between the ground reference and the base -->
    <joint name="footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <!--
        AXIS 1: BASE ROTATION

        The rotating base is positioned on top
        of the fixed base (Z = 10 cm).

        Rotation around the Z axis.
        Joint limits: -90° to +90° (180° total range).
    -->
    <joint name="base_rotation_joint" type="revolute">
        <parent link="base_link"/>
        <child link="rotating_base_link"/>

        <origin xyz="0 0 0.10" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>

        <limit lower="-1.5708"
               upper="1.5708"
               effort="10"
               velocity="1.0"/>
    </joint>


    <!--
        AXIS 2: SHOULDER

        The upper arm starts at the top
        of the rotating base (Z = 10 cm relative
        to the rotating_base_link frame).

        Rotation around the Y axis.
        Joint limits: -90° to +90°.
    -->
    <joint name="shoulder_joint" type="revolute">
        <parent link="rotating_base_link"/>
        <child link="upper_arm_link"/>

        <origin xyz="0 0 0.10" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>

        <limit lower="-1.5708"
               upper="1.5708"
               effort="10"
               velocity="1.0"/>
    </joint>


    <!--
        AXIS 3: ELBOW

        The forearm is connected to the end
        of the upper arm, 30 cm above the
        upper_arm_link frame.

        Rotation around the Y axis.
        Joint limits: -135° to +135°.
    -->
    <joint name="elbow_joint" type="revolute">
        <parent link="upper_arm_link"/>
        <child link="forearm_link"/>

        <origin xyz="0 0 0.30" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>

        <limit lower="-2.3562"
               upper="2.3562"
               effort="10"
               velocity="1.0"/>
    </joint>


    <!-- Fixed connection between the forearm and the end effector -->
    <joint name="tool_joint" type="fixed">
        <parent link="forearm_link"/>
        <child link="tool_link"/>

        <origin xyz="0 0 0.25" rpy="0 0 0"/>
    </joint>

</robot>